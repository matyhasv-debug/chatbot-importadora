# ─── WhatsApp Business API (Meta) ──────────────────────────────────────────────
# Obtén estos datos en: https://developers.facebook.com/apps/
WHATSAPP_TOKEN=tu_token_de_whatsapp_aqui
WHATSAPP_PHONE_ID=tu_phone_number_id_aqui
WEBHOOK_VERIFY_TOKEN=elige_una_clave_secreta_larga
# App Secret: Meta App → Configuración → Básica → "Secreto de la aplicación"
# Activa la verificación de firma HMAC en todos los webhooks entrantes (recomendado)
META_APP_SECRET=tu_app_secret_de_meta_aqui

# ─── IA — Groq (GRATIS) ────────────────────────────────────────────────────────
# Obtén tu API key en: https://console.groq.com/keys
GROQ_API_KEY=tu_groq_api_key_aqui

# ─── Bsale ─────────────────────────────────────────────────────────────────────
# Obtén tu token en: Bsale → Configuración → API
# (Opcional si usas modo catálogo manual)
BSALE_TOKEN=tu_bsale_token_aqui

# ─── Panel de administración ────────────────────────────────────────────────────
# JWT_SECRET: clave larga y aleatoria para firmar los tokens de sesión del panel
# PANEL_SECRET: clave para proteger operaciones de superadmin (crear tenants, etc.)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
PANEL_SECRET=otra_clave_secreta_para_el_panel_admin

# ─── Notificaciones al dueño ────────────────────────────────────────────────────
# Número en formato internacional sin + (ej: 56912345678)
DUENO_WHATSAPP=56912345678

# ─── Servidor ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Logs ────────────────────────────────────────────────────────────────────────
# Niveles: debug | info | warn | error  (por defecto: debug en dev, info en prod)
# LOG_LEVEL=info

# ─── Base de datos ───────────────────────────────────────────────────────────────
# Opcional: ruta personalizada. Por defecto usa ./data/chatbot.db
# DB_PATH=/ruta/personalizada/chatbot.db

# ─── Backup en Google Drive (opcional) ──────────────────────────────────────────
# JSON completo de la cuenta de servicio de Google Cloud
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_DRIVE_FOLDER_ID=id_de_la_carpeta_en_drive
